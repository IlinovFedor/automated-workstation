# Обычно ничего задавать не нужно: в проде API доступно по /api того же сайта.

# Адрес API, если он на другом домене (по умолчанию /api).
VITE_API_URL=
# Адрес API для ссылок подписки в календаре (по умолчанию тот же, что VITE_API_URL, то есть /api этого сайта).
# При разработке на localhost календари не смогут его скачать — задайте прод: https://timetables.pslu.ru/api
VITE_WEBCAL_URL=

# Только для `npm run dev`: куда проксировать /api (по умолчанию прод https://timetables.pslu.ru/api).
# DEV_API=http://localhost:8081
